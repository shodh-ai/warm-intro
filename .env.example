# Required for transcription + note cleanup
OPENAI_API_KEY=sk-...

# App access code (set privately for the deployment)
APP_ACCESS_CODE=

# Encrypts the Google session cookie
APP_SECRET=replace-with-a-long-random-secret

# Google OAuth Web application credentials
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Optional: permitted Google email addresses, separated by commas
ALLOWED_GOOGLE_EMAIL=

# Optional: use an existing tracker with Contacts and Settings tabs after sign-in.
GOOGLE_SHEET_ID=

# Optional after production domain is known. If omitted, forwarded host/proto are used.
APP_BASE_URL=https://intro.shodh.ai

# Current defaults; only set these if you intentionally want to override them.
CLEANUP_MODEL=gpt-5.6-luna
